<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <!-- Browse: navigation rail over the pages, like YouTube for Android TV. -->
    <FrameLayout
        android:id="@+id/tv_browse"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <FrameLayout
            android:id="@+id/tv_pages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="104dp"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/tv_page_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:orientation="vertical"
                    android:paddingTop="36dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="340dp">

                    <TextView
                        android:id="@+id/tv_hero_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="2"
                        android:textColor="#F1F1F1"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/tv_hero_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#AAAAAA"
                        android:textSize="16sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="false">

                    <androidx.leanback.widget.VerticalGridView
                        android:id="@+id/tv_home_rows"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingBottom="40dp" />

                    <TextView
                        android:id="@+id/tv_home_status"
                        android:layout_marginStart="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:textColor="#AAAAAA"
                        android:textSize="18sp" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tv_page_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/tv_search_box"
                    android:layout_marginStart="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginEnd="64dp"
                    android:background="@drawable/tv_search_bg"
                    android:drawableStart="@drawable/ic_tv_search"
                    android:drawablePadding="16dp"
                    android:hint="Search YouTube"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingHorizontal="24dp"
                    android:singleLine="true"
                    android:textColor="#F1F1F1"
                    android:textColorHint="#8A8A8A"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tv_search_status"
                    android:paddingStart="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp"
                    android:text="Search for videos, or paste a YouTube link"
                    android:textColor="#AAAAAA"
                    android:textSize="16sp" />

                <androidx.leanback.widget.VerticalGridView
                    android:id="@+id/tv_search_results"
                    android:paddingStart="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingTop="12dp"
                    android:paddingBottom="40dp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/tv_page_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/tv_settings_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="40dp"
                    android:paddingEnd="120dp"
                    android:paddingBottom="48dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Settings"
                        android:textColor="#F1F1F1"
                        android:textSize="30sp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <TextView
            android:id="@+id/tv_cast_chip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="48dp"
            android:background="@drawable/tv_chip_bg"
            android:drawableStart="@drawable/ic_cast"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:textColor="#F1F1F1"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/tv_nav"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/tv_nav_logo"
                android:layout_width="40dp"
                android:layout_height="28dp"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/tv_logo" />

            <include
                android:id="@+id/nav_search"
                layout="@layout/tv_nav_item" />

            <include
                android:id="@+id/nav_home"
                layout="@layout/tv_nav_item" />

            <include
                android:id="@+id/nav_account"
                layout="@layout/tv_nav_item" />

            <include
                android:id="@+id/nav_settings"
                layout="@layout/tv_nav_item" />

            <Space
                android:layout_width="1dp"
                android:layout_height="96dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Full-screen player with YouTube-style overlay controls. -->
    <FrameLayout
        android:id="@+id/tv_player_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/tv_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            app:use_controller="false" />

        <ProgressBar
            android:id="@+id/tv_buffering"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_player_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/tv_chip_bg"
            android:gravity="center"
            android:maxWidth="640dp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="16dp"
            android:textColor="#F1F1F1"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_seek_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/tv_chip_bg"
            android:paddingHorizontal="22dp"
            android:paddingVertical="10dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/tv_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_gravity="top"
                android:background="@drawable/tv_scrim_top" />

            <View
                android:layout_width="match_parent"
                android:layout_height="440dp"
                android:layout_gravity="bottom"
                android:background="@drawable/tv_scrim_bottom" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="vertical"
                android:paddingStart="56dp"
                android:paddingTop="36dp"
                android:paddingEnd="56dp">

                <TextView
                    android:id="@+id/tv_player_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/tv_player_channel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#CCCCCC"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tv_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="56dp"
                android:paddingEnd="56dp"
                android:paddingBottom="16dp">

                <androidx.media3.ui.DefaultTimeBar
                    android:id="@+id/tv_timebar"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:focusable="true"
                    app:bar_height="4dp"
                    app:buffered_color="#80FFFFFF"
                    app:played_color="@color/yt_red"
                    app:scrubber_color="@color/yt_red"
                    app:unplayed_color="#40FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:clipChildren="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/tv_btn_play"
                        android:layout_marginStart="0dp"
                        style="@style/Widget.LiTube.Tv.RoundButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="Play or pause"
                        android:padding="14dp"
                        android:src="@drawable/ic_pause" />

                    <ImageButton
                        android:id="@+id/tv_btn_restart"
                        style="@style/Widget.LiTube.Tv.RoundButton"
                        android:contentDescription="Start over"
                        android:src="@drawable/ic_replay" />

                    <ImageButton
                        android:id="@+id/tv_btn_next"
                        style="@style/Widget.LiTube.Tv.RoundButton"
                        android:contentDescription="Next video"
                        android:src="@drawable/ic_next" />

                    <ImageButton
                        android:id="@+id/tv_btn_captions"
                        style="@style/Widget.LiTube.Tv.RoundButton"
                        android:contentDescription="Captions"
                        android:src="@drawable/ic_subtitles_on" />

                    <ImageButton
                        android:id="@+id/tv_btn_quality"
                        style="@style/Widget.LiTube.Tv.RoundButton"
                        android:contentDescription="Quality"
                        android:src="@drawable/ic_tv_hd" />

                    <ImageButton
                        android:id="@+id/tv_btn_speed"
                        style="@style/Widget.LiTube.Tv.RoundButton"
                        android:contentDescription="Playback speed"
                        android:src="@drawable/ic_tv_speed" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_up_next_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Up next"
                    android:textColor="#F1F1F1"
                    android:textSize="18sp" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/tv_up_next"
                    android:layout_width="match_parent"
                    android:layout_height="216dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingTop="12dp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
