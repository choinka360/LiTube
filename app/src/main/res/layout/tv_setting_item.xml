<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/tv_setting_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:paddingHorizontal="24dp"
    android:paddingVertical="14dp">

    <ImageView
        android:id="@+id/tv_setting_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        app:tint="@color/tv_on_focus_text" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_setting_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/tv_on_focus_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_setting_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:textColor="@color/tv_on_focus_secondary"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
